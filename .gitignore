# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Built debs (don't commit, these are local artifacts)
output/*.deb

# Cached downloads (don't commit, can be large)
cached_downloads/*
!cached_downloads/.gitkeep

# Build workspace — git clones and build artifacts (don't commit, local only)
builds/*
!builds/.gitkeep

# Git worktrees (local only, never committed)
.worktrees/

# Editor
.idea/
.vscode/
*.swp

.claude
